# Local development (default)
DATABASE_URL=file:./prisma/dev.db

# Production (Vercel + Turso) — set these in Vercel env vars
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
# DATABASE_URL=file:./dev.db
# INGEST_API_KEY=long-random-secret

# Optional — push ingest from your PC to the live hub
# HUB_URL=https://your-app.vercel.app
# INGEST_API_KEY=same-as-vercel

# Riot Games API (SoloQ ranks on the Stats tab)
# https://developer.riotgames.com/
# RIOT_API_KEY=RGAPI-your-key

# Team login (username/password sessions — accounts are created manually)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=long-random-secret-at-least-16-chars
#
# Create / update accounts:
#   npx tsx scripts/create-user.ts --username coach --name "Coach" --password "secret" --role COACH
#   npx tsx scripts/create-user.ts --username mid --name "Midlaner" --password "secret" --role PLAYER
